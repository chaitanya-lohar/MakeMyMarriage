{
  "name": "makemymarriage",
  "private": true,
  "description": "MakeMyMarriage — wedding planning and management platform for Indian weddings",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "api:contract": "turbo run generate --filter=@makemymarriage/api-client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d mongo redis mailpit",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.4"
  }
}
