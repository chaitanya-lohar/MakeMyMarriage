{
  "name": "@makemymarriage/api",
  "version": "0.0.0",
  "private": true,
  "description": "MakeMyMarriage NestJS modular monolith: HTTP API (main.ts) and BullMQ worker (worker.ts)",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "openapi:export": "node dist/openapi/export-openapi.js ../../packages/api-client/openapi.json"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "6.3.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "mongoose": "9.10.2",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.13",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@makemymarriage/eslint-config": "workspace:*",
    "@makemymarriage/tsconfig": "workspace:*",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
