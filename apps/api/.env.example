# MakeMyMarriage API + worker — local development.
# Copy to `.env` (git-ignored). Staging/production inject these from the platform's
# secret manager; never commit real values.

NODE_ENV=development
# local | test | staging | production
APP_ENV=local

# HTTP API port and worker health-probe port
PORT=3001
WORKER_HEALTH_PORT=3002

# Local: `docker compose up -d mongo redis`. Staging/production: MongoDB Atlas + managed Redis (rediss://).
MONGODB_URI=mongodb://localhost:27017/makemymarriage?directConnection=true
REDIS_URL=redis://localhost:6379

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Swagger UI at /api/v1/docs. Keep false in production.
OPENAPI_DOCS_ENABLED=true

# Auth (decision 0015). Use a different random value per environment:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-development-secret-0000000000
# Public web origin used in emailed links (password reset)
WEB_APP_URL=http://localhost:3000

# Email: smtp = local Mailpit inbox (http://localhost:8025); resend = real email
EMAIL_TRANSPORT=smtp
EMAIL_FROM=MakeMyMarriage <no-reply@makemymarriage.com>
SMTP_HOST=localhost
SMTP_PORT=1025
# RESEND_API_KEY=   (required when EMAIL_TRANSPORT=resend)

# Invitation-token encryption keys (decision 0018): current key first, then older keys
# kept for rotation, e.g. v2:<key>,v1:<key>. Generate each key with: openssl rand -base64 32
# Local-only value; staging and production use their own keys from the secret manager.
INVITATION_TOKEN_KEYS=v1:JzfJXCXg/Mr+UunbAT5DR5LDwO64KflHo9q11VEpcvU=

# ---------------------------------------------------------------------------
# Added by the module that first needs them (not read yet):
#   S3:            AWS_REGION, S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   Integrations:  GOOGLE_PLACES_API_KEY, YOUTUBE_API_KEY
# ---------------------------------------------------------------------------
