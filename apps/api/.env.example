# MakeMyMarriage API + worker — local development.
# Copy to `.env` (git-ignored). Staging/production inject these from the platform's
# secret manager; never commit real values.

NODE_ENV=development
# local | test | staging | production
APP_ENV=local

# HTTP API port and worker health-probe port
PORT=3001
WORKER_HEALTH_PORT=3002

# Local: `docker compose up -d mongo redis`. Staging/production: MongoDB Atlas + managed Redis (rediss://).
MONGODB_URI=mongodb://localhost:27017/makemymarriage?directConnection=true
REDIS_URL=redis://localhost:6379

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Swagger UI at /api/v1/docs. Keep false in production.
OPENAPI_DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Added by the module that first needs them (not read by the scaffold):
#   Auth:          JWT_ACCESS_SECRET, JWT_ACCESS_TTL, REFRESH_TOKEN_TTL
#   S3:            AWS_REGION, S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   Email:         RESEND_API_KEY, EMAIL_FROM
#   Integrations:  GOOGLE_PLACES_API_KEY, YOUTUBE_API_KEY
# ---------------------------------------------------------------------------
