{
  "name": "@makemymarriage/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed REST client for the MakeMyMarriage API, generated from its OpenAPI contract",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@makemymarriage/eslint-config": "workspace:*",
    "@makemymarriage/tsconfig": "workspace:*",
    "eslint": "10.11.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
